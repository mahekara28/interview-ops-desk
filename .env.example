# Optional. Demo mode works without any credentials. Do not commit .env.
PORT=4310
# greenhouse (default) or json-http. Both are read-only.
OPS_PROVIDER=greenhouse
# For the included API demo: npm run provider:demo, then uncomment:
# OPS_PROVIDER=json-http
# OPS_PROVIDER_URL=http://127.0.0.1:4312/snapshot
# Optional bearer token for your own JSON endpoint (never commit):
# OPS_PROVIDER_TOKEN=
# OPS_DATA_DIR=/absolute/path/to/private/ops-data
# Live, read-only Greenhouse Harvest v3 (scope: harvest:interviews:list)
# GREENHOUSE_CLIENT_ID=
# GREENHOUSE_CLIENT_SECRET=
# GREENHOUSE_USER_ID=
# Optional comma-separated job IDs to restrict the interview feed
# GREENHOUSE_JOB_IDS=
# A short-lived Google OAuth access token with calendar.events.readonly scope.
# Token is kept in environment only; refresh it outside the application.
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# GOOGLE_CALENDAR_ID=primary
